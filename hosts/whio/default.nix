# ./hosts/whio/default.nix
{ specialArgs
, ...
}:
let
  inherit (specialArgs) hostname username;
in
{

  imports = [
    #+----- Host specific configuration ----------
    ./hardware-configuration.nix
    ./persistence.nix # Preservation configuration

    #+----- Basic configuration ------------------
    ../../lib/nixos/asus.nix
    ../../lib/nixos/base-packages.nix
    ../../lib/nixos/base-security.nix
    ../../lib/nixos/bluetooth.nix
    ../../lib/nixos/btrfs.nix
    ../../lib/nixos/certificates.nix
    ../../lib/nixos/docker.nix
    ../../lib/nixos/flatpak.nix
    ../../lib/nixos/gaming.nix
    ../../lib/nixos/hardware-services.nix
    ../../lib/nixos/hyprland-services.nix
    ../../lib/nixos/llm-agents.nix
    ../../lib/nixos/maintenance.nix
    ../../lib/nixos/multimedia.nix
    ../../lib/nixos/nvidia.nix
    ../../lib/nixos/secureboot.nix
    ../../lib/nixos/xdg.nix
    ../../lib/nixos/virt.nix
    ../../lib/nixos/zram.nix
  ];

  hardware.cpu.amd.updateMicrocode = true;

  hardware.nvidia = {
    powerManagement.finegrained = false;
    prime = {
      amdgpuBusId = "PCI:65:0:0";
      nvidiaBusId = "PCI:01:0:0";
      offload = {
        enable = true;
        enableOffloadCmd = true; # command: nvidia-offload
      };
    };
  };

  boot = {
    blacklistedKernelModules = [ "nouveau" ];
    extraModprobeConfig = ''
      options iwlwifi disable_11ax=Y
    '';
    kernel.sysctl = {
      "vm.vfs_cache_pressure" = 50;
      "vm.swappiness" = 10;
      "vm.dirty_background_ratio" = 5;
      "vm.dirty_ratio" = 10;
      "kernel.sysrq" = 1;
      "kernel.hung_task_timeout_secs" = 30;
    };
  };

  #+----- Logging & Crash Observability --------
  services.journald.extraConfig = ''
    Storage=persistent
    SyncIntervalSec=1s
    SystemMaxUse=1G
    SystemKeepFree=10G
    SystemMaxFileSize=100M
    MaxRetentionSec=14day
  '';

  systemd.coredump = {
    enable = true;
    settings = {
      Coredump = {
        Storage = "persistent";
        Compress = "yes";
        ProcessSizeMax = "1G";
        ExternalSizeMax = "1G";
        MaxUse = "1G";
        KeepFree = "10G";
      };
    };
  };

  # Time and locale are specific to the physical location
  time.timeZone = "Pacific/Auckland";
  i18n.defaultLocale = "en_NZ.UTF-8";

  networking = {
    firewall = {
      enable = true;
      allowedTCPPorts = [ 11434 ];
    };
    hostName = hostname;
    networkmanager.enable = false;
    wireless.iwd = {
      enable = true;
      settings = {
        General = {
          # Needed to stop the wifi from flipping to roaming and back
          RoamThreshold = -80;
          RoamThreshold5G = -80;
        };
        Network = {
          EnableIPv6 = true;
        };
        Rank = {
          BandModifier5G = 2.0;
        };
        Scan = {
          DisableRoamingScan = true;
        };
      };
    };
  };

  security.pki.certificateFiles = [
    ../tahi/tahi_root.crt
  ];

  services = {
    avahi.enable = true; # Discovery
    blueman.enable = true; # Bluetooth
    libinput.enable = true; # Input
    printing.enable = true; # Printing
    resolved.enable = true; # DNS
    udev = {
      enable = true;
      # Disable wakeup on NVIDIA PCIe bridge (0000:00:01.1) to ignore HDMI HPD jitter
      extraRules = ''
        ACTION=="add|change", SUBSYSTEM=="pci", KERNEL=="0000:00:01.1", ATTR{power/wakeup}="disabled"
      '';
    };
  };

  #+----- Sleep & Wakeup Management ------------
  powerManagement.powerDownCommands = ''
    # Prevent NVIDIA PCIe bridge (GPP0) from waking the laptop on HDMI/display hotplug jitter
    if grep -q "^GPP0.*\*enabled" /proc/acpi/wakeup; then
      echo GPP0 > /proc/acpi/wakeup
    fi
    if [ -w /sys/bus/pci/devices/0000:00:01.1/power/wakeup ]; then
      echo disabled > /sys/bus/pci/devices/0000:00:01.1/power/wakeup
    fi
  '';

  users = {
    users.${username} = {
      home = "/home/${username}";
      isNormalUser = true;
      extraGroups = [
        "input"
        "network"
        "users"
        "video"
        "wheel"
        username
      ];
      # generated by `mkpasswd -m scrypt --rounds=11`
      initialHashedPassword = "$7$GU..../....S9EPW0eEM5JL4uh1Bo1yr/$bDP2HRn7G8LV8jLV2yj3DQHJJPE0svzRh0Q2fEPePN9";
    };
    users.root.initialHashedPassword = "$7$GU..../....S9EPW0eEM5JL4uh1Bo1yr/$bDP2HRn7G8LV8jLV2yj3DQHJJPE0svzRh0Q2fEPePN9";
  };

}
